* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #101010;
  color: white;
}

header {
  padding: 20px;
  background: #181818;
  text-align: center;
}

h1 {
  color: #ff4d00;
}

main {
  padding: 30px 20px;
  text-align: center;
}

button {
  background: #ff4d00;
  color: white;
  border: none;
  padding: 14px 25px;
  border-radius: 8px;
  font-size: 16px;
}
